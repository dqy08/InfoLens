{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "Info Highlight",
  "version": "0.1.0",
  "description": "Paint a surprisal heatmap on the current webpage.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "optional_host_permissions": ["file:///*", "https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.hf.co/*", "https://*.xethub.hf.co/*", "https://*.modelscope.cn/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Info Highlight",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
